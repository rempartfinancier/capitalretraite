# --- Côté serveur uniquement (variables Vercel, JAMAIS préfixées VITE_) ---
# Clé API Brevo : utilisée par api/subscribe.js et api/send-lead-email.js.
BREVO_API_KEY=

# Identifiants numériques des listes Brevo (Contacts > Listes), un par source de lead.
# Chaque liste déclenche l'automatisation de séquence correspondante (docs/emails/).
BREVO_LIST_ID_LEAD_MAGNET_AV=
BREVO_LIST_ID_LEAD_MAGNET_CHECKLIST=
BREVO_LIST_ID_SIMULATEUR=
BREVO_LIST_ID_OUTILS=
BREVO_LIST_ID_BILAN=
BREVO_LIST_ID_NEWSLETTER=

# --- Côté client (publiques, sans secret) ---
# Anciennes URLs d'action de formulaires Brevo : plus utilisées par le lead magnet.
VITE_BREVO_FORM_ACTION_BILAN=
VITE_BREVO_FORM_ACTION_CONTACT=
